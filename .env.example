SECRET_KEY=

DEBUG=

# Comma-separated hosts. Include the compose service name (e.g. "backend") for container-to-container calls.
ALLOWED_HOSTS=

DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# Inside Docker: redis://redis:6379/0
# Local dev:     redis://localhost:6379/0
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_RESULT_EXPIRES=3600

ACCESS_TOKEN_LIFETIME=
REFRESH_TOKEN_LIFETIME=

JWT_SIGNING_KEY=


# Default model for quick start / testing (~2 GB download).
# For a more realistic "production" experience, use e.g. llama3:8b (~4.7 GB).
OLLAMA_MODEL_NAME=llama3.2:3b

# Optional. Ollama API endpoint; defaults to http://localhost:11434/api/generate (host).
# Docker Compose overrides this to http://ollama:11434/api/generate automatically.
# OLLAMA_API_URL=http://localhost:11434/api/generate

# AI provider (ollama = local default; openai | deepseek | gemini = cloud, OpenAI-compatible).
AI_PROVIDER=ollama

# Cloud provider credentials (required only when AI_PROVIDER is a cloud provider).
# Leave AI_BASE_URL and AI_MODEL empty to use the provider defaults
# (see backend/agents/providers/openai_compat.py).
# AI_API_KEY=
# AI_BASE_URL=
# AI_MODEL=

EMAIL_HOST =
EMAIL_PORT =
EMAIL_USE_TLS =

EMAIL_HOST_USER =
EMAIL_HOST_PASSWORD =
DEFAULT_FROM_EMAIL =


CORS_ALLOWED_ORIGINS=

# Populates the DB with sample data (seed_all) on the first backend start when
# no seed data exists. Set to "false" to disable.
SEED_ON_START=true

VITE_ENABLE_DEMO_MODE="false"

# Default API base URL for the React frontend.
VITE_API_BASE_URL="http://localhost:8000"